# --- Meta WhatsApp Business Cloud API -------------------------------------
# Meta App → WhatsApp → API setup
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
GRAPH_VERSION=v23.0

# Bot's WhatsApp number, international format without +
BOT_NUMBER=2348012345678

# Where the flyer QR points. Web RSVP: {PUBLIC_BASE_URL}/rsvp
# Leave unset to fall back to the wa.me chat link (WhatsApp path).
RSVP_URL=

# RSVP line printed on the flyer
RSVP_NAMES=Mrs. Adaeze 0803 000 0000 · Mr. Emeka 0805 000 0000

# --- Supabase (guest store + RSVP list) ------------------------------------
# Project Settings → API → URL + service_role key
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Check-in + email -------------------------------------------------------
# Public URL of this server — baked into pass QR codes and email links.
PUBLIC_BASE_URL=https://yourapp.onrender.com
# Staff PIN for door check-in endpoints
DOOR_KEY=choose-a-long-random-staff-pin
# Host PIN for the admin console (/admin — invites + request approvals)
ADMIN_KEY=choose-a-long-random-admin-pin
# Optional Resend email delivery (unset = skip emails, WhatsApp unaffected)
RESEND_API_KEY=
EMAIL_FROM=Ozinegbe 70 <invite@yourdomain.com>

PORT=3000
